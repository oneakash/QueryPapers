# Application Settings
APP_NAME="LangGraph HITL RAG API"
ENVIRONMENT="development"

# Infrastructure (PostgreSQL Checkpointer/Store & Qdrant Vector DB)
POSTGRES_DSN="postgresql://rag_user:rag_password@localhost:5432/rag_db"
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="tenant_documents"

# Active LLM Configuration (Default: Free Google AI Studio Gemini)
# Get your free API key at: https://aistudio.google.com/apikey
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.6-flash"
LLM_API_KEY="your_free_google_ai_studio_api_key_here"
LLM_BASE_URL="https://api.openai.com/v1"

# --- Alternative Option A: Groq Free Tier (OpenAI-Compatible) ---
# LLM_PROVIDER="openai_compatible"
# LLM_MODEL="openai/gpt-oss-20b"
# LLM_API_KEY="gsk_your_groq_api_key_here"
# LLM_BASE_URL="https://api.groq.com/openai/v1"

# --- Alternative Option B: Local Ollama (100% Offline) ---
# LLM_PROVIDER="openai_compatible"
# LLM_MODEL="qwen2.5:7b"
# LLM_API_KEY="ollama"
# LLM_BASE_URL="http://localhost:11434/v1"

# Active Embedding Configuration (Default: Free gemini-embedding-2)
# NOTE: Changing EMBEDDING_MODEL or EMBEDDING_DIMENSIONS requires a new
# QDRANT_COLLECTION name or re-indexing existing documents.
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_API_KEY="your_free_google_ai_studio_api_key_here"
EMBEDDING_BASE_URL="https://api.openai.com/v1"
EMBEDDING_DIMENSIONS=768

# RAG & Human-in-the-Loop (HITL) Thresholds
RETRIEVAL_TOP_K=5
HITL_CONFIDENCE_THRESHOLD=0.60
MAX_USER_RULES=10
REQUEST_TIMEOUT_SECONDS=20.0

# --- Ingestion ---
# Byte-identical re-uploads are always skipped. Set to true to also replace an
# existing document when a *different* file is uploaded under the same filename.
REPLACE_ON_FILENAME_CONFLICT=false

# --- Observability ---
# Structured logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# LangSmith tracing (disabled by default)
# Set LANGSMITH_TRACING=true and provide API key to enable distributed tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=